---
import '../styles/global.css';
import type { Locale } from '../i18n';
import { getDict, locales, pathFor } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  localizedPage?: 'home' | 'contact';
}

const { locale, title, description, localizedPage } = Astro.props;
const dict = getDict(locale);
const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;
const localizedPath = localizedPage === 'contact' ? 'contact' : '';
const canonicalUrl = Astro.site && localizedPage
  ? new URL(pathFor(locale, localizedPath), Astro.site).href
  : undefined;
const alternateUrls = Astro.site && localizedPage
  ? locales.map((alternateLocale) => ({
      locale: alternateLocale,
      href: new URL(pathFor(alternateLocale, localizedPath), Astro.site!).href,
    }))
  : [];
const defaultUrl = Astro.site && localizedPage
  ? new URL(pathFor('ja', localizedPath), Astro.site).href
  : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      alternateUrls.map((alternate) => (
        <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
      ))
    }
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
