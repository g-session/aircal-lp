---
import '../styles/global.css';
import type { Locale } from '../i18n';
import { getDict, locales, pathFor } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** OGP画像のパス（base からの相対）。省略時はサイト共通の OGP 画像 */
  ogImage?: string;
  localizedPage?: 'home' | 'contact';
}

const { locale, title, description, ogImage, localizedPage } = Astro.props;
const dict = getDict(locale);
const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;
const localizedPath = localizedPage === 'contact' ? 'contact' : '';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// OGP / canonical は絶対 URL が必須（Astro.site = https://g-session.github.io）
const ogImagePath = ogImage ?? `${base}/images/ogp.png`;
const ogImageUrl = new URL(ogImagePath, Astro.site).href;
const canonicalPath = localizedPage
  ? pathFor(locale, localizedPath)
  : Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, Astro.site).href;
const alternateUrls = Astro.site && localizedPage
  ? locales.map((alternateLocale) => ({
      locale: alternateLocale,
      href: new URL(pathFor(alternateLocale, localizedPath), Astro.site!).href,
    }))
  : [];
const defaultUrl = Astro.site && localizedPage
  ? new URL(pathFor('ja', localizedPath), Astro.site).href
  : undefined;
const maximizedLocale = new Intl.Locale(locale).maximize();
const ogLocale = `${maximizedLocale.language}_${maximizedLocale.region?.toUpperCase() ?? 'US'}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {
      alternateUrls.map((alternate) => (
        <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
      ))
    }
    {defaultUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="aircal" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@aircal_app" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
