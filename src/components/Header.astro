---
import type { Locale } from '../i18n';
import { getDict, localeLabels, locales, pathFor } from '../i18n';

interface Props {
  locale: Locale;
  page?: 'home' | 'contact';
}

const { locale, page = 'home' } = Astro.props;
const pagePath = page === 'contact' ? 'contact' : '';
const dict = getDict(locale);
---

<header class="site-header">
  <div class="container row">
    <a class="brand" href={pathFor(locale)} aria-label="aircal">
      aircal
    </a>

    <div class="nav">
      <label class="visually-hidden" for="locale-switch">{dict.nav.langSwitch}</label>
      <select id="locale-switch" class="lang" aria-label={dict.nav.langSwitch}>
        {
          locales.map((targetLocale) => (
            <option
              value={targetLocale}
              data-target={pathFor(targetLocale, pagePath)}
              selected={locale === targetLocale}
            >
              {localeLabels[targetLocale]}
            </option>
          ))
        }
      </select>
    </div>
  </div>
</header>

<script>
  const localeSelect = document.querySelector<HTMLSelectElement>('#locale-switch');
  localeSelect?.addEventListener('change', () => {
    const target = localeSelect.selectedOptions[0]?.dataset.target;
    if (target) window.location.assign(target);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    font-family: var(--font-en);
    font-weight: 900;
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang {
    display: block;
    width: min(280px, 60vw);
    min-height: 42px;
    padding: 8px 36px 8px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    font: inherit;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg);
    transition: background-color 0.2s ease, border-color 0.2s ease;
    cursor: pointer;
  }

  .lang:hover {
    background: var(--bg-soft);
    border-color: var(--fg-faint);
  }

  .lang:focus-visible {
    outline: 3px solid var(--fg-muted);
    outline-offset: 3px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
