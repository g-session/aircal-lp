---
import type { Locale } from '../i18n';
import { getDict } from '../i18n';
import { imageDimensions, imagePath } from '../i18n/assets';
import Header from './Header.astro';
import Hero from './Hero.astro';
import ScreenshotStrip from './ScreenshotStrip.astro';
import FeatureSection from './FeatureSection.astro';
import FinalCta from './FinalCta.astro';
import Footer from './Footer.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dimensions = imageDimensions(locale);

const featureImages = [
  '01-month',
  '02-google',
  '03-share',
  '04-themes',
  '05-widget',
] as const;
---

<Header locale={locale} />
<main>
  <Hero locale={locale} />
  <ScreenshotStrip locale={locale} />
  {
    dict.features.map((f, i) => (
      <>
        <div class="divider" />
        <FeatureSection
          number={f.number}
          title={f.title}
          body={f.body}
          alt={f.alt}
          image={imagePath(locale, featureImages[i], base)}
          imageWidth={dimensions.width}
          imageHeight={dimensions.height}
          reverse={i % 2 === 1}
        />
      </>
    ))
  }
  <div class="divider" />
  <FinalCta locale={locale} />
</main>
<Footer locale={locale} />
